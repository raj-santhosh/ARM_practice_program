Write an ECP recevie charcters continuesly using UART0 and retransmit same char on serial terminal.

#include<lpc21xx.h>
#include "uart0_header.h"
#define THRE ((U0LSR>>5)&1)
#define RDR (U0LSR & 1)

int main()
{
	unsigned int temp;
	UART0_init(9600);
	while(1)
	{
		temp=UART0_rx();  //waiting for valid data
		UART0_tx(temp);  //retransmit same char on serial terminal
	}
}	
//--------------------------------------UART0_driver-------------------------------------
void UART0_init(unsigned int baud)
{
	int PCLK,result=0;
	if(VPBDIV==0)
		PCLK =1500000;
	else if(VPBDIV==1)
		PCLK = 60000000;
	else if(VPBDIV==2)
		PCLK = 30000000;
	result =PCLK/(16*baud);   //calculate UART baudrate
	PINSEL0 |= 0x5;           // P0.0(TXD0), P0.1(RXDO) enable alternate pins
	U0LCR =0x83;              //unlock baudrate
	U0DLL =result & 0xff;     //Extract lower 8-bits
	U0DLM =(result>>8)&0xff;  //Extract higher 8-bits
	U0LCR =0x03;              //lock baudrate
}

void UART0_tx(unsigned char data)
{
	U0THR =data;    //UART0 transmitter hold register ,write only register
	while(THRE==0); // wait for UOTHR become no data
}
unsigned char UART0_rx()
{
	while(RDR==0); //U0RBR wait received valid data  
		return U0RBR; // return received data
}
