#include<lpc21xx.h>
#include "header.h"
#define THRE ((U0LSR>>5)&1)
#define RDR (U0LSR&1)
void UART0_init(unsigned int baud)
{
        int PCLK,result=0;
        if(VPBDIV ==0x0)
                PCLK =15000000;
        else if(VPBDIV == 0x01)
                PCLK =60000000;
        else if(VPBDIV == 0x02)
                PCLK =60000000;
        result = PCLK /(16*baud);
        PINSEL0 |= 0x5;                         //select TXD0,RXD0 PIN
        U0LCR = 0x83;                           // unlock baudrate
        U0DLL = result & 0xFF;          //Extract lower 8-bits using U0DLL register
        U0DLM = (result>>8) &0xFF;      //Extract higher 8-bits using U0DLL register
        U0LCR = 0x03;
}
//---------------------------------UART0_RX_TX()--------------------------------------
void UART0_tx(unsigned char data)
{
        U0THR =data;
        while(THRE ==0);  // Wait U0LSR becomes empty
}

unsigned char UART0_rx()
{
        while(RDR==0);   // Wait receive valid data
        return U0RBR;
}

//---------------------------------UART0_string--------------------------------------
void UART0_string(char *p)
{
        while(*p!=0)
        {
                UART0_tx(*p);
                p++;
        }
}
//---------------------------------UART0_Integer--------------------------------------
void UART0_integer(int num)
{
        int a[10],i;
        if(num==0)
        {
                UART0_tx('0');
        }
        if(num<0)
        {
                UART0_tx('-');
                num = -num;
        }
        i=0;
        while(num>0)
        {
                a[i]= num %10;
                num = num/10;
                i++;
        }
        for(i=i-1 ;i>=0 ;i--)
        {
                UART0_tx(a[i]);
        }

}
//---------------------------------UART0_Float--------------------------------------
void UART0_float(float f)
{
        int num;
        if(f==0)
        {
                UART0_string("0.0");
        }
        if(f<0)
        {
                UART0_data('-');
                f = -f;
        }
        num =f;
        UART0_integer(num);
        UART0_tx('.');
        num = (f-num)*1000000;
        UART0_integer(num);
}
