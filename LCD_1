//  Write an ECP print a to z 1st row and ascii value on 2nd row

#include<lpc21.xx.h>
int i,num;
while(1)
{
		for(i=0;i<26;i++)
		{
			lcd_cmd(0x80);         // LCD 1st ROW first position
			lcd_data('a'+i);
			
      lcd_cmd(0xC0);         // LCD 2nd ROW first position
			num='a'+i;
			if(num>=100)
      {
				lcd_data(num/100+48); // hun
				lcd_data((num/10)%10+48); //tens
				lcd_data(num%10+48);  //ones
			}
			else
			{
			lcd_data(num/10+48);
			lcd_data(num%10+48);
			}
			delay_ms(200);
			lcd_cmd(0x01);
		}
	}
// -----------------------------------lcd_8-bit driver----------------------------------------------------
void lcd_data(unsigned char data)
{
	IOCLR0=0x7ff;			// clear all pin on lCD
	IOSET0=data;
	IOSET0=1<<8; 			//set RS pin for data mode 
	IOCLR0=1<<9; 			//clear RW pin 
	IOSET0=1<<10; 			//set EN enable pin 
	delay_ms(2);
	IOCLR0=1<<10; 			//clear En enable pin
}
void lcd_cmd(unsigned char cmd)
{
	IOCLR0=0x7ff;			// clear all pin on lCD
	IOSET0=cmd;
	IOCLR0=1<<8; 			//clear RS pin for cmd mode
	IOCLR0=1<<9; 			//clear RW pin
	IOSET0=1<<10; 			//set EN pin
	delay_ms(2);
	IOCLR0=1<<10; 			//clear EN pin
}
void lcd_init()
{
	IODIR0=0x7ff; 			// all GPIO pins are o/p direction 
	PINSEL0=0x0; 			// don't distrub other GPIO PINS 
	lcd_cmd(0x38); 			// double line enable in 8-bit mode 
	lcd_cmd(0x0E);			// enable cursor
}
