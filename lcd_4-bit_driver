//-----------------------------------LCD_4-bit_driver---------------------------------
#include<lpc21xx.h>
#include "header.h"
void lcd_string(char *ptr)
{
	while(*ptr!=0)
	{
		lcd_data(*ptr);
		ptr++;
	}
}

void lcd_data(unsigned char data)
{
	IOCLR1=0x7FE<<16;
	IOSET1=(data & 0xF0)<<16;     //higher nibble
	IOSET1=1<<17;     //set RS pin
	IOCLR1=1<<18;     //clear RW pin 
	IOSET1=1<<19;     //set EN enable pin 
	delay_ms(200);
	IOCLR1=1<<19;     //clear En enable pin
	
	IOCLR1=0x7FE<<16;
	IOSET1=(data & 0x0F)<<20;     //lower nibble
	IOSET1=1<<17;     //set RS pin
	IOCLR1=1<<18;     //clear RW pin 
	IOSET1=1<<19;     //set EN enable pin 
	delay_ms(200);
	IOCLR1=1<<19; 		//clear En enable pin
}

void lcd_cmd(unsigned char cmd)
{
	IOCLR1=0xFE<<16;
	IOSET1=(cmd & 0xF0)<<16;     //higher nibble
	IOCLR1=1<<17; 		//set RS pin
	IOCLR1=1<<18; 		//clear RW pin 
	IOSET1=1<<19; 		//set EN enable pin 
	delay_ms(200);
	IOCLR1=1<<19; 		//clear En enable pin
	
	IOCLR1=0xFE<<16;
	IOSET1=(cmd & 0x0F)<<20;     //lower nibble
	IOCLR1=1<<17; 		//set RS pin
	IOCLR1=1<<18; 		//clear RW pin 
	IOSET1=1<<19; 	//set EN enable pin 
	delay_ms(200);
	IOCLR1=1<<19; 		//clear En enable pin
}

void lcd_init()
{
	IODIR1=0xFE<<16; // select GPIO pins are output
	PINSEL2 |=0x00000000; 
	lcd_cmd(0x01); 		// clear screen
	lcd_cmd(0x02);  	// enable 4-bit mode
	lcd_cmd(0x28); 		// double line enable in 4-bit mode 
	lcd_cmd(0x0E);		// enable cursor
}

void lcd_integer(int num)
{
	int a[10],i=0;
	if(num==0)
	{
		lcd_data('0');    // if zero means display on '0'
	}
	if(num<0)
	{
		num =-num;
		lcd_data('-');    // for -ve number 
	}
	while(num>0)
	{
		a[i]=num%10+48;   
		num=num/10;
		i++;
	}
	for(i=i-1;i>0;i++)
	{
		lcd_data(a[i]);
	}
}

void lcd_float(float f)
{
	int num;
	if(f<0)
	{
		f= -f;
		lcd_data('-');
	}
	if(f==0)
	{
		lcd_string("0.0");
		return;
	}
	num=f;
	lcd_integer(num);
	num = (f-num)*1000000;
	lcd_integer(num);
		
}
