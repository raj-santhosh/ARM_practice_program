Write an Embedded C program control 7 swtich to 3 (active LOW )LEDs blink binary format...

#include<lpc21xx.h>          
#include "header.h"

#define sw1 ((IOPIN0>>1)&1)
#define sw2 ((IOPIN0>>2)&1)
#define sw3 ((IOPIN0>>3)&1)
#define sw4 ((IOPIN0>>4)&1)
#define sw5 ((IOPIN0>>5)&1)
#define sw6 ((IOPIN0>>6)&1)
#define sw7 ((IOPIN0>>7)&1)
#define LED1 (1<<17)
#define LED2 (1<<18)
#define LED3 (1<<19)

int main()
{
	IODIR0 |= LED1 | LED2 | LED3;
	IOSET0 = LED1 | LED2 | LED3;     // Before LED all are off state
	while(1)
	{
		if(sw1 == 0)
			IOCLR0 = LED1;                // 0 0 1
		else if(sw2 == 0)
			IOCLR0 = LED2;                // 0 1 0
		else if(sw3 == 0)               
			IOCLR0 = LED1 | LED2;         // 0 1 1
		else if(sw4 ==0)
			IOCLR0 = LED3;                // 1 0 0
		else if(sw5==0)
			IOCLR0 = LED1 | LED3;         // 1 0 1
		else if(sw6==0)
			IOCLR0 = LED2 | LED3;         // 1 1 0
		else if(sw7==0)
			IOCLR0 = LED1 | LED2 | LED3;  // 1 1 1
		else
			IOSET0 = LED1 | LED2 | LED3;  // else all LED is OFF
	}

}
