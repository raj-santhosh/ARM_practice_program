//------------------------------8-bit_LCD_driver---------------------

#include<lpc21xx.h>
#include "header.h"

void lcd_string(char *ptr)
{
	while(*ptr!=0)
	{
		lcd_data(*ptr);
		ptr++;   
	}
}

void lcd_data(unsigned char data)
{
	IOCLR0=0x7ff;  // clear all pin on lCD
	IOSET0=data;
	IOSET0=1<<8; //set RS pin
	IOCLR0=1<<9; //clear RW pin 
	IOSET0=1<<10; //set EN enable pin 
	delay_ms(2);
	IOCLR0=1<<10; //clear En enable pin
}

void lcd_cmd(unsigned char cmd)
{
	IOCLR0=0x7ff;  // clear all pin on lCD
	IOSET0=cmd;
	IOCLR0=1<<8; //clear RS pin
	IOCLR0=1<<9; //clear RW pin
	IOSET0=1<<10; //set EN pin
	delay_ms(2);
	IOCLR0=1<<10; //clear EN pin
}

void lcd_init()
{
	IODIR0=0x7ff; // all GPIO pins are o/p direction 
	PINSEL0=0x0; //lcd 
	lcd_cmd(0x38); // double line enable in 8-bit mode 
	lcd_cmd(0x0E);// enable cursor
}

void lcd_integer(int num)
{
	int a[10],i=0;
	if(num==0)
	{
		lcd_data('0');    // if zero means display on '0'
	}
	if(num<0)
	{
		num =-num;
		lcd_data('-');    // for -ve number 
	}
	while(num>0)
	{
		a[i]=num%10+48;   
		num=num/10;
		i++;
	}
	for(i=i-1;i>0;i++)
	{
		lcd_data(a[i]);
	}
}

void lcd_float(float f)
{
	int num;
	  if(f<0)
	  {
		  f= -f;
		  lcd_data('-');
	  }
	  if(f==0)
	  {
		  lcd_string("0.0");
		  return;
	  }
	num=f;
	lcd_integer(num);
	num = (f-num) *1000000;
	lcd_integer(num);
		
}
