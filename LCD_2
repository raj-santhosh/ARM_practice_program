Write an ECP shift a string 0x80 to 0x8F with 500ms_delay and continue on LCD

#include<lpc21xx.h>
#include "header.h"
int main()
{
  lcd_init();
  while(1)
	{
		for(int i=0;i<16;i++)
		{
			lcd_cmd(0x80+i);
			lcd_string("Dragon");
			delay_ms(500);
			lcd_cmd(0x01);
		}
	}
}

// -----------------------------------LCD_STRING_function-------------------------------------------
void lcd_string(char *ptr)
{
	while(*ptr!=0)
	{
		lcd_data(*ptr);
		ptr++;   
	}
}
