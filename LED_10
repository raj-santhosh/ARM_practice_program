WRITE AN ECP TO DISPLAY THE DIVERGENCE ON 8 LEDs using LPC2129 
#include <lpc21xx.h>
#define LED 0xFF
typedef unsigned int us; 

void delay_ms(us ms)
{
    T0PR = 15000 - 1;    // Prescaler for 1ms delay at 15 MHz PCLK
    T0TC = T0PC =0;        // Reset & disable timer
    T0TCR = 0x01;        // Enable timer
    while (T0TC < ms);   // Wait until the timer counter reaches 'ms'
    T0TCR = 0x00;        // Stop timer
}
int main()
{
    int i,j;                      
    PINSEL0 = (0x00000000);           // Configure P0.0–P0.15 as GPIO
    IODIR0 |= LED;             // Set P0.0–P0.7 as output
		IOSET0 = LED;          // Turn OFF all LEDs initially (active low: 1 = OFF)
		while (1)                  
    {
        for (i=3,j=4; i>=0; i--,j++)
        {
            IOCLR0 = (1<<i | 1<<j); // Turn ON two LED  
            delay_ms(100);  // Small delay to visualize the LED lighting effect
						IOSET0 = (1<<i | 1<<j); //Turn OFF two LED 
				}
    }
}
