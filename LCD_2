Write an ECP print string on LCD

#include<lpc21xx.h>
#include "header.h"
int main()
{
  lcd_init();
  while(1)
	{
		for(int i=0;i<16;i++)
		{
			lcd_cmd(0xC0+i);
			lcd_string("Dragon booster");
			delay_ms(200);
			lcd_cmd(0x01);
		}
	}
}

// -----------------------------------LCD_STRING_function-------------------------------------------
void lcd_string(char *ptr)
{
	while(*ptr!=0)
	{
		lcd_data(*ptr);
		ptr++;   
	}
}
