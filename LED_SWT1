// Write an ECP Two way switch to on LED. 

#include<lpc21xx.h>
#include "header.h"
#define LED 1<<7
#define sw1 ((IOPIN0>>14)&1)
#define sw2 ((IOPIN0>>15)&1)
int main()
{
	int c=0;
  IODIR0=LED;
	IOSET0=LED;
		while(1)
		{
			if(sw1==0)
			{
				while(sw1==0);
					c++;
			}
			if(sw2==0)
			{
				while(sw2==0);
					c++;
			}
			if(c==1)
				IOCLR0=LED;
			else
			{
				IOSET0=LED;
				c=0;
			}
		}
}
